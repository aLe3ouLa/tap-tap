    },
    "warning": {
      "700": { "$type": "color", "$value": "#FE9B0E" },
      "600": { "$type": "color", "$value": "#FFAD0D" },
      "500": { "$type": "color", "$value": "#FFC62B" },
      "400": { "$type": "color", "$value": "#FFDD82" },
