  "shadow": {
    "elevation": {
      "1": {
        "$type": "shadow",
        "$value": [
          {
            "color": "rgba(0, 0, 0, 0.02)",
            "offsetX": "0px",
            "offsetY": "1px",
            "blur": "1px",
            "spread": "0px"
          },
          {
            "color": "rgba(0, 0, 0, 0.04)",
            "offsetX": "0px",
            "offsetY": "2px",
            "blur": "4px",
            "spread": "0px"
          }
        ]
      },
      "2": {
        "$type": "shadow",
        "$value": [
          {
            "color": "rgba(0, 0, 0, 0.04)",
            "offsetX": "0px",
            "offsetY": "1px",
            "blur": "4px",
            "spread": "0px"
          },
          {
            "color": "rgba(0, 0, 0, 0.08)",
            "offsetX": "0px",
            "offsetY": "4px",
            "blur": "10px",
            "spread": "0px"
          }
        ]
      },
      "3": {
        "$type": "shadow",
        "$value": [
          {
            "color": "rgba(0, 0, 0, 0.04)",
            "offsetX": "0px",
            "offsetY": "2px",
            "blur": "20px",
            "spread": "0px"
          },
          {
            "color": "rgba(0, 0, 0, 0.08)",
            "offsetX": "0px",
            "offsetY": "8px",
            "blur": "32px",
            "spread": "0px"
          }
        ]
      },
      "4": {
        "$type": "shadow",
        "$value": [
          {
            "color": "rgba(0, 0, 0, 0.06)",
            "offsetX": "0px",
            "offsetY": "8px",
            "blur": "20px",
            "spread": "0px"
          },
          {
            "color": "rgba(0, 0, 0, 0.12)",
            "offsetX": "0px",
            "offsetY": "24px",
            "blur": "60px",
            "spread": "0px"
          }
        ]
      }
    }
  },
  "font": {
    "family": {
      "base": {
        "$type": "fontFamily",
        "$value": "'Segoe UI', system-ui, -apple-system, sans-serif"
      }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 }
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.base}",
        "fontWeight": "{font.weight.medium}",
        "fontSize": "1.875rem",
        "lineHeight": "2.375rem"
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.base}",
        "fontWeight": "{font.weight.medium}",
        "fontSize": "1.5rem",
        "lineHeight": "2rem"
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.base}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "1.25rem",
        "lineHeight": "1.75rem"
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.base}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "1.125rem",
        "lineHeight": "1.625rem"
      }
    },
    "subtitle": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.base}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "1rem",
        "lineHeight": "1.5rem"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.base}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "0.875rem",
        "lineHeight": "1.375rem"
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.base}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "0.75rem",
        "lineHeight": "1.125rem"
      }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "5": { "$type": "dimension", "$value": "1.25rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "7": { "$type": "dimension", "$value": "2rem" },
    "8": { "$type": "dimension", "$value": "2.5rem" },
    "9": { "$type": "dimension", "$value": "3rem" },
    "10": { "$type": "dimension", "$value": "4rem" }
  },
  "radius": {
    "md": { "$type": "dimension", "$value": "0.25rem" }
  }
}
