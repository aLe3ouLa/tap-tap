{
  "name": "design-system-workspace",
  "version": "0.0.0",
  "workspaces": ["projects/design-system"],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "tokens:build": "cd projects/design-system && style-dictionary build --config style-dictionary.config.js",
    "storybook": "ng run design-system:storybook",
    "build-storybook": "ng run design-system:build-storybook",
    "icons:build": "cd projects/design-system && node build-sprite.js",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.5.2",
    "@angular-devkit/architect": "^0.2201.0",
    "@angular-devkit/build-angular": "^22.1.0",
    "@angular-devkit/core": "^22.1.0",
    "@angular/animations": "^22.1.0",
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/angular-vite": "^10.6.0",
    "@types/node": "^20",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "playwright": "latest",
    "prettier": "^3.8.1",
    "storybook": "^10.6.0",
    "style-dictionary": "^5.5.3",
    "svg-sprite": "^2.0.4",
    "typescript": "~6.0.2",
    "vite": "latest",
    "vitest": "^4.0.8"
  }
}
